      "source": [
        "# En Colab activa GPU en Entorno de ejecución > Cambiar tipo de entorno de ejecución.\n",
        "from pathlib import Path\n",
        "import csv, json, random, time\n",
        "import numpy as np\n",
        "import torch\n",
        "from torch import nn\n",
        "from torch.nn.utils import spectral_norm\n",
        "from torch.utils.data import Dataset, DataLoader\n",
        "from torchvision import transforms, utils\n",
        "from PIL import Image\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Monta Drive solo si lo usas. Si los datos están en /content cambia BASE_DIR.\n",
        "from google.colab import drive\n",
        "drive.mount('/content/drive')\n",
        "BASE_DIR = Path('/content/drive/MyDrive')\n",
        "DATA_DIR = BASE_DIR / 'datos_limpios_hf' / 'images'\n",
        "OUTPUT_DIR = BASE_DIR / 'resultados' / 'comparacion_controlada'\n",
        "assert DATA_DIR.is_dir(), f'No existe {DATA_DIR}'\n",
        "OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "SEED=2026; Z_DIM=128; BATCH_SIZE=8; EPOCHS=50; LR=2e-4; BETA1=.5\n",
        "CHECKPOINT_EVERY=5\n",
        "# Una corrida por ejecución. Usa un valor diferente y ejecuta todas las celdas de nuevo.\n",
        "EXPERIMENT='base'  # 'base', 'perdida_minimax', 'estabilizacion_spectral'\n",
        "assert EXPERIMENT in {'base','perdida_minimax','estabilizacion_spectral'}\n",
        "device=torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n",
        "print('Dispositivo:',device, 'Datos:',DATA_DIR, 'Experimento:',EXPERIMENT)\n"
      ],
      "id": "N4z9hXQaoBR5"
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "8K4b1TrjoBR8",
        "outputId": "791d09e2-b93e-425c-e2d5-25a447292615"
      },
      "execution_count": 4,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Imágenes limpias: 1191 Primera imagen: /content/drive/MyDrive/datos_limpios_hf/images/img_000000.png\n"
          ]
        }
      ],
      "source": [
        "def set_seed(seed):\n",
        "    random.seed(seed); np.random.seed(seed); torch.manual_seed(seed)\n",
        "    if torch.cuda.is_available(): torch.cuda.manual_seed_all(seed)\n",
        "    torch.backends.cudnn.deterministic=True\n",
        "    torch.backends.cudnn.benchmark=False\n",
        "\n",
        "class CharacterDataset(Dataset):\n",
        "    def __init__(self,folder):\n",
        "        self.paths=sorted(p for p in folder.rglob('*.png') if p.is_file())\n",
        "        if len(self.paths)<2: raise ValueError('Se requieren al menos dos PNG limpios')\n",
        "        self.transform=transforms.Compose([transforms.Resize((64,64)),\n",
        "            transforms.ToTensor(),transforms.Normalize((.5,)*3,(.5,)*3)])\n",
        "    def __len__(self): return len(self.paths)\n",
        "    def __getitem__(self,i):\n",
        "        with Image.open(self.paths[i]) as image:\n",
        "            return self.transform(image.convert('RGB'))\n",
        "\n",
        "dataset=CharacterDataset(DATA_DIR)\n",
        "print('Imágenes limpias:',len(dataset),'Primera imagen:',dataset.paths[0])\n",
        "\n",
        "class Generator(nn.Module):\n",
        "    def __init__(self):\n",
        "        super().__init__()\n",
        "        self.net=nn.Sequential(\n",
        "            nn.ConvTranspose2d(Z_DIM,256,4,1,0,bias=False),nn.BatchNorm2d(256),nn.ReLU(True),\n",
        "            nn.ConvTranspose2d(256,128,4,2,1,bias=False),nn.BatchNorm2d(128),nn.ReLU(True),\n",
        "            nn.ConvTranspose2d(128,64,4,2,1,bias=False),nn.BatchNorm2d(64),nn.ReLU(True),\n",
        "            nn.ConvTranspose2d(64,32,4,2,1,bias=False),nn.BatchNorm2d(32),nn.ReLU(True),\n",
        "            nn.ConvTranspose2d(32,3,4,2,1,bias=False),nn.Tanh())\n",
        "    def forward(self,z): return self.net(z)\n",
        "\n",
        "class Discriminator(nn.Module):\n",
        "    def __init__(self,use_spectral=False):\n",
        "        super().__init__()\n",
        "        def conv(a,b,k=4,s=2,p=1):\n",
        "            layer=nn.Conv2d(a,b,k,s,p,bias=False)\n",
        "            return spectral_norm(layer) if use_spectral else layer\n",
        "        # Se conserva BatchNorm en D: la única intervención es spectral_norm en sus convoluciones.\n",
        "        self.net=nn.Sequential(conv(3,32),nn.LeakyReLU(.2,inplace=True),\n",
        "            conv(32,64),nn.BatchNorm2d(64),nn.LeakyReLU(.2,inplace=True),\n",
        "            conv(64,128),nn.BatchNorm2d(128),nn.LeakyReLU(.2,inplace=True),\n",
        "            conv(128,256),nn.BatchNorm2d(256),nn.LeakyReLU(.2,inplace=True),\n",
        "            conv(256,1,4,1,0))\n",
        "    def forward(self,x): return self.net(x).flatten(1).squeeze(1)\n",
        "\n",
        "def init_weights(module):\n",
        "    if isinstance(module,(nn.Conv2d,nn.ConvTranspose2d)):\n",
        "        # Con spectral_norm, inicializar el parámetro original.\n",
        "        nn.init.normal_(getattr(module,'weight_orig',module.weight),0,.02)\n",
        "    elif isinstance(module,nn.BatchNorm2d):\n",
        "        nn.init.normal_(module.weight,1,.02); nn.init.zeros_(module.bias)\n",
        "\n",
        "set_seed(SEED)\n",
        "G=Generator();G.apply(init_weights)\n",
        "# Se inicializa primero el mismo D base en todas las corridas; en la variante\n",
        "# espectral se copian esos mismos pesos al parámetro weight_orig.\n",
        "set_seed(SEED+500)\n",
        "reference_d=Discriminator(False);reference_d.apply(init_weights)\n",
        "if EXPERIMENT=='estabilizacion_spectral':\n",
        "    D=Discriminator(True)\n",
        "    for reference, target in zip(reference_d.modules(),D.modules()):\n",
        "        if isinstance(reference,nn.Conv2d):\n",
        "            target.weight_orig.data.copy_(reference.weight.data)\n",
        "        elif isinstance(reference,nn.BatchNorm2d):\n",
        "            target.load_state_dict(reference.state_dict())\n",
        "else:\n",
        "    D=reference_d\n",
        "del reference_d\n",
        "G=G.to(device);D=D.to(device)\n",
        "set_seed(SEED+900)  # Aísla el ruido del entrenamiento de la creación de modelos.\n",
        "with torch.no_grad():\n",
        "    assert G(torch.randn(2,Z_DIM,1,1,device=device)).shape==(2,3,64,64)\n",
        "    assert D(torch.randn(2,3,64,64,device=device)).shape==(2,)\n",
        "\n",
        "opt_g=torch.optim.Adam(G.parameters(),lr=LR,betas=(BETA1,.999))\n",
        "opt_d=torch.optim.Adam(D.parameters(),lr=LR,betas=(BETA1,.999))\n",
        "bce=nn.BCEWithLogitsLoss()\n",
        "fixed_z=torch.randn(16,Z_DIM,1,1,generator=torch.Generator().manual_seed(SEED+1)).to(device)\n",
        "run=OUTPUT_DIR/EXPERIMENT\n",
        "run.mkdir(parents=True,exist_ok=True)\n",
        "config=dict(experiment=EXPERIMENT,seed=SEED,epochs=EPOCHS,batch_size=BATCH_SIZE,\n",
        "            lr=LR,beta1=BETA1,z_dim=Z_DIM,images=len(dataset),source=str(DATA_DIR))\n",
        "(run/'config.json').write_text(json.dumps(config,indent=2),encoding='utf-8')\n",
        "torch.save(fixed_z.cpu(),run/'fixed_z.pt')\n"
      ],
      "id": "8K4b1TrjoBR8"
    },
