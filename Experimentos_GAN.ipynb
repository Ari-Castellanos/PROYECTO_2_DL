      ],
      "source": [
        "@torch.no_grad()\n",
        "def save_fixed(epoch):\n",
        "    was_training=G.training;G.eval()\n",
        "    utils.save_image(G(fixed_z).cpu(),run/f'fixed_epoch_{epoch:03d}.png',nrow=4,\n",
        "                     normalize=True,value_range=(-1,1))\n",
        "    G.train(was_training)\n",
        "\n",
        "def checkpoint(epoch,history):\n",
        "    torch.save(dict(epoch=epoch,generator=G.state_dict(),discriminator=D.state_dict(),\n",
        "                    optimizer_g=opt_g.state_dict(),optimizer_d=opt_d.state_dict(),\n",
        "                    fixed_z=fixed_z.cpu(),history=history,config=config),run/'latest.pt')\n",
        "    with (run/'losses.csv').open('w',newline='',encoding='utf-8') as f:\n",
        "        writer=csv.DictWriter(f,fieldnames=['epoch','d_loss','g_loss'])\n",
        "        writer.writeheader();writer.writerows(history)\n",
        "\n",
        "history=[]\n",
        "save_fixed(0)\n",
        "for epoch in range(1,EPOCHS+1):\n",
        "    # Generador independiente: mismo barajado en cada experimento, sin importar RNG del modelo.\n",
        "    shuffle_rng=torch.Generator().manual_seed(SEED+1000+epoch)\n",
        "    loader=DataLoader(dataset,batch_size=BATCH_SIZE,shuffle=True,num_workers=0,\n",
        "                      pin_memory=False,generator=shuffle_rng,drop_last=True)\n",
        "    G.train();D.train();g_sum=d_sum=0.;count=0\n",
        "    start=time.time()\n",
        "    for real in loader:\n",
        "        real=real.to(device)\n",
        "        n=real.size(0);count+=n\n",
        "        opt_d.zero_grad(set_to_none=True)\n",
        "        z=torch.randn(n,Z_DIM,1,1,device=device)\n",
        "        real_logits=D(real)\n",
        "        fake_logits=D(G(z).detach())\n",
        "        d_loss=bce(real_logits,torch.ones_like(real_logits))+bce(fake_logits,torch.zeros_like(fake_logits))\n",
        "        d_loss.backward();opt_d.step()\n",
        "\n",
        "        opt_g.zero_grad(set_to_none=True)\n",
        "        for param in D.parameters(): param.requires_grad_(False)\n",
        "        z=torch.randn(n,Z_DIM,1,1,device=device)\n",
        "        logits=D(G(z))\n",
        "        if EXPERIMENT=='perdida_minimax':\n",
        "            # Min_G log(1-D(G(z))) = -BCEWithLogits(logits, 0).\n",
        "            g_loss=-bce(logits,torch.zeros_like(logits))\n",
        "        else:\n",
        "            g_loss=bce(logits,torch.ones_like(logits))\n",
        "        g_loss.backward();opt_g.step()\n",
        "        for param in D.parameters(): param.requires_grad_(True)\n",
        "        d_sum+=d_loss.item()*n;g_sum+=g_loss.item()*n\n",
        "    row=dict(epoch=epoch,d_loss=d_sum/count,g_loss=g_sum/count)\n",
        "    history.append(row)\n",
        "    print(f\"{EXPERIMENT} {epoch:03d}/{EPOCHS} D={row['d_loss']:.3f} G={row['g_loss']:.3f} {time.time()-start:.1f}s\",flush=True)\n",
        "    if epoch==1 or epoch%CHECKPOINT_EVERY==0 or epoch==EPOCHS:\n",
        "        save_fixed(epoch);checkpoint(epoch,history)\n"
      ],
